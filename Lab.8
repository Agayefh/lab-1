import math

# Funksiya təyin olunur
def f(x):
    return x - 2 - x**(1/4)

# Bisection metodu
def bisection(a, b, tol=1e-7, max_iter=100):
    if f(a) * f(b) >= 0:
        print("Bisection metodu üçün uyğun aralıq deyil.")
        return None

    for i in range(max_iter):
        c = (a + b) / 2
        if abs(f(c)) < tol or (b - a) / 2 < tol:
            return c
        if f(a) * f(c) < 0:
            b = c
        else:
            a = c
    print("Maksimum iterasiya sayı aşdı.")
    return None

# Verilən aralıq
a = 3.0
b = 4.0

# Həlli tapırıq
root = bisection(a, b)
if root is not None:
    print(f"Təqribi kök: {root}")
